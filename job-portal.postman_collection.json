{
  "info": {
    "name": "Job Portal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the whole collection in order. Set adminEmail and adminPassword first. Uses the cookie jar; the missing-token request disables it. Only sample records created during this run are removed."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "DemoPass123!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Health\") {",
          "  const run = Date.now() + \"-\" + Math.random().toString(16).slice(2, 7);",
          "  [\"seeker\", \"employer\", \"otherEmployer\"].forEach(role => pm.collectionVariables.set(role + \"Email\", role + \".\" + run + \"@example.com\"));",
          "  pm.collectionVariables.set(\"deadline\", new Date(Date.now() + 30 * 86400000).toISOString());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"JSON response without passwords\", () => {",
          "  pm.response.to.be.json;",
          "  pm.expect(pm.response.json()).to.have.property(\"success\");",
          "  pm.expect(pm.response.text()).not.to.match(/\"password\"|\"tokenVersion\"|\\$2[aby]\\$/);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Employer creates a job",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/employer-api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Employer\",\n  \"email\": \"{{employerEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"employerId\", pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register second employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
