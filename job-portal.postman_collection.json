                  "pm.test(\"Login sets an httpOnly cookie\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"accessToken=\").and.include(\"HttpOnly\").and.include(\"SameSite=Strict\"));"
